{
  "ConnectionStrings": {
    "DefaultConnection": "Server=your-production-server;Database=AutomatedCVSystemDb;User Id=app_user;Password=your-secure-password;TrustServerCertificate=true;MultipleActiveResultSets=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "yourdomain.com,www.yourdomain.com",
  "AllowedOrigins": "https://yourdomain.com,https://www.yourdomain.com",
  "CVOutputPath": "/app/generated-cvs",
  "JwtSettings": {
    "SecretKey": "your-super-secret-key-here-must-be-at-least-32-characters-long",
    "Issuer": "AutomatedCVSystem",
    "Audience": "AutomatedCVSystem-Users",
    "ExpirationMinutes": 60
  }
}
